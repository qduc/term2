+it('preserves the tail section intact, including its first character (regression: resumed text started mid-token)', () => {
+  // 120 chars with maxCharacters 100 → keepChars = 40. The last 40 chars
+  // must survive byte-for-byte; a previous off-by-one kept only 39,
+  // dropping the tail's first character.
+  const tailSegment = Array.from({ length: 40 }, (_, i) => 'abcdefghij'[i % 10]).join('');
+  const output = `${'M'.repeat(80)}${tailSegment}`;
+  const result = trimOutput(output, undefined, 100);
+
+  expect(result.endsWith(tailSegment)).toBe(true);
+  expect(result).toContain('[40 characters trimmed]');
+});
