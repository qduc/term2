diff --git a/source/lib/agent-factory.test.ts b/source/lib/agent-factory.test.ts
index b2bc03f5..b6fb7d47 100644
--- a/source/lib/agent-factory.test.ts
+++ b/source/lib/agent-factory.test.ts
@@ -7,6 +7,8 @@ import type {
 import { it, expect } from 'vitest';
 import { z } from 'zod';
 import path from 'path';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
 import { SANDBOX_TEMP_DIR } from '../utils/shell/temp-dir.js';
 import { buildAgent, buildAgentTools } from './agent-factory.js';
 import { clearModelCache, fetchModels } from '../services/model-service.js';
@@ -195,21 +197,47 @@ it.sequential('keeps the complete wrapped registry when run_code is unavailable'
 });
 
 it.sequential('requires non-constant approval predicates to declare a direct fallback', () => {
-  const { deps } = createDeps({ settingsValues: { 'app.searchViaShell': 'off' } });
-  const raw = getAgentDefinition(
-    {
-      settingsService: deps.settings,
-      loggingService: deps.logger,
-    },
-    'gpt-4o',
-  );
-
-  for (const tool of raw.tools) {
-    const compactPredicate = Function.prototype.toString.call(tool.needsApproval).replace(/\s/g, '').replace(/;$/, '');
-    const isConstantPredicate = compactPredicate.endsWith('=>false') || compactPredicate.endsWith('=>true');
-    if (!isConstantPredicate && !RUN_CODE_PROHIBITED_TOOLS.has(tool.name)) {
-      expect(tool.canRequireApproval, `${tool.name} needs an explicit approval fallback`).toBe(true);
+  // Memory mutation tools (memory_update, memory_delete) gate approval on
+  // shell.autoApproveMode rather than parameters, so they must be part of the
+  // audited surface: a missing canRequireApproval on them silently removes the
+  // tool from the direct path whenever run_code is present and refuses every
+  // script-side call, because script approval is impossible.
+  const memoryDirectory = mkdtempSync(path.join(tmpdir(), 'agent-factory-memory-'));
+  try {
+    const { deps } = createDeps({
+      settingsValues: {
+        'app.searchViaShell': 'off',
+        'memory.enabled': true,
+        'memory.directory': memoryDirectory,
+        'memory.contextBudgetChars': 4000,
+      },
+    });
+    const raw = getAgentDefinition(
+      {
+        settingsService: deps.settings,
+        loggingService: deps.logger,
+      },
+      'gpt-4o',
+    );
+
+    // Sanity: the audited surface actually contains the approval-gated memory
+    // mutation tools; otherwise the loop below passes vacuously.
+    expect(raw.tools.map((tool) => tool.name)).toEqual(
+      expect.arrayContaining(['memory_create', 'memory_update', 'memory_delete']),
+    );
+
+    for (const tool of raw.tools) {
+      const compactPredicate = Function.prototype.toString
+        .call(tool.needsApproval)
+        .replace(/\s/g, '')
+        .replace(/;$/, '');
+      const isConstantPredicate = compactPredicate.endsWith('=>false') || compactPredicate.endsWith('=>true');
+      if (!isConstantPredicate && !RUN_CODE_PROHIBITED_TOOLS.has(tool.name)) {
+        expect(tool.canRequireApproval, `${tool.name} needs an explicit approval fallback`).toBe(true);
+      }
     }
+  } finally {
+    rmSync(memoryDirectory, { recursive: true, force: true });
   }
 });
 
