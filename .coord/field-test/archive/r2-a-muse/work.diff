+it.sequential('requires every approval-capable tool in the full registry to declare a direct fallback', () => {
+  // The minimal config above leaves memory, sessions, worktree, and delegation
+  // tools unregistered, so settings-gated predicates there (e.g. memory
+  // mutations that require approval outside auto mode) escape the drift check.
+  // Register everything and re-apply the same invariant.
+  const memoryDir = mkdtempSync(path.join(tmpdir(), 'term2-approval-flag-'));
+  try {
+    const logger = createMockLogger();
+    const settings = createMockSettings({
+      'app.searchViaShell': 'off',
+      'memory.enabled': true,
+      'memory.directory': memoryDir,
+      'memory.contextBudgetChars': 12_000,
+      'memory.searchDefaultLimit': 10,
+      'memory.searchMaxLimit': 50,
+      'agent.smartModel': 'test-mentor',
+    });
+    const raw = getAgentDefinition(
+      {
+        settingsService: settings,
+        loggingService: logger,
+        executionContext: { getCwd: () => process.cwd(), isRemote: () => false } as any,
+        askMentor: async () => 'mentor-response',
+        runSubagent: async () => ({ finalText: 'subagent-response' } as any),
+        runSubagentAsync: async () => ({ runId: 'run-1', status: 'running' } as any),
+        getSubagentResult: async () => ({ status: 'completed', finalText: '' } as any),
+        getSubagentStatus: (() => ({ status: 'running' } as any)) as any,
+        sendSubagentMessage: (() =>
+          ({ ok: true, runId: 'run-1', status: 'running', delivery: 'queued' } as any)) as any,
+        cancelSubagentRun: (() => ({ ok: true, runId: 'run-1', status: 'cancelling' } as any)) as any,
+        getAskUserAnswer: () => undefined,
+        skillsService: {
+          getAvailableSkillsForModel: () => [{ name: 'test-skill' }],
+          getSkillCatalog: () => '',
+        } as any,
+        backgroundShellRegistry: new BackgroundShellRegistry<any>(),
+        sessionBrowser: {} as any,
+        requestSessionRollover: () => ({ outcome: 'accepted' } as any),
+        configureTaskCheckIn: (() => ({ ok: true } as any)) as any,
+        setTaskCheckInPolicy: () => {},
+      },
+      'gpt-4o',
+    );
+
+    expect(raw.tools.map((tool) => tool.name)).toEqual(
+      expect.arrayContaining(['memory_update', 'memory_delete', 'ask_user', 'enter_worktree']),
+    );
+    for (const tool of raw.tools) {
+      const compactPredicate = Function.prototype.toString
+        .call(tool.needsApproval)
+        .replace(/\s/g, '')
+        .replace(/;$/, '');
+      const isConstantPredicate = compactPredicate.endsWith('=>false') || compactPredicate.endsWith('=>true');
+      if (!isConstantPredicate && !RUN_CODE_PROHIBITED_TOOLS.has(tool.name)) {
+        expect(tool.canRequireApproval, `${tool.name} needs an explicit approval fallback`).toBe(true);
+      }
+    }
+  } finally {
+    rmSync(memoryDir, { recursive: true, force: true });
+  }
+});
+
