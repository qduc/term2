@@ -0,0 +1,158 @@
+import assert from 'node:assert/strict';
+import fc from 'fast-check';
+import { QueueController } from '../../source/services/queue/queue-controller.ts';
+
+// A serial reference model for the public follow-up queue lane: FIFO dispatch,
+// failure pauses retained work; removing/discarding all retained work releases
+// the pause (see #cancel and interrupted-active restoration's empty-pause invariant).
+const action = fc.oneof(
+  fc.record({
+    kind: fc.constant('submit'),
+    text: fc.string({ minLength: 1, maxLength: 30 }).filter((s) => !!s.trim()),
+  }),
+  fc.record({
+    kind: fc.constantFrom('complete', 'fail', 'remove', 'edit', 'resume', 'discard', 'stale'),
+    index: fc.nat(30),
+  }),
+);
+export const queueProperties = [
+  {
+    name: 'queue.restore-pause',
+    property: fc.asyncProperty(
+      fc.constantFrom('failure', 'manual', 'recovered_interrupted'),
+      fc.array(
+        fc.string({ minLength: 1, maxLength: 30 }).filter((s) => !!s.trim()),
+        { maxLength: 30 },
+      ),
+      async (reason, texts) => {
+        const queue = texts.map((text, index) => ({
+          id: `saved-${index}`,
+          text,
+          sequence: index + 1,
+          submittedAt: '2026-01-01T00:00:00.000Z',
+        }));
+        const starts = [];
+        const controller = new QueueController({
+          driver: {
+            start: (execution) => {
+              starts.push(execution.item.text);
+            },
+            cancel: () => true,
+          },
+          snapshotFactory: (item) => ({ text: item.text }),
+          persistence: {
+            load: () => ({ version: 1, nextSequence: queue.length + 1, queue, pause: { reason } }),
+            replace: () => {},
+          },
+        });
+        assert.equal(controller.state().kind, queue.length ? 'paused' : 'idle');
+        assert.deepEqual(
+          controller.state().queue.map(({ text }) => text),
+          texts,
+        );
+        assert.deepEqual(starts, []);
+        await controller.command({ kind: 'submit', text: 'fresh input' });
+        assert.deepEqual(starts, queue.length ? [] : ['fresh input']);
+        if (queue.length) assert.equal(controller.state().reason, reason);
+      },
+    ),
+  },
+  {
+    name: 'queue.serial-actions',
+    property: fc.asyncProperty(fc.array(action, { maxLength: 30 }), async (actions) => {
+      let next = 0;
+      let execution = 0;
+      let previousExecutionId;
+      const starts = [];
+      const controller = new QueueController({
+        driver: {
+          start: (execution) => {
+            starts.push({ id: execution.item.id, text: execution.item.text, snapshotText: execution.snapshot.text });
+          },
+          cancel: () => true,
+        },
+        snapshotFactory: (item) => ({ text: item.text }),
+        ids: { item: () => `item-${++next}`, execution: () => `execution-${++execution}` },
+        now: () => '2026-01-01T00:00:00.000Z',
+        capacity: 100,
+      });
+      const model = { active: null, queue: [], paused: false, starts: [] };
+      const dispatch = () => {
+        if (!model.active && !model.paused && model.queue.length) {
+          model.active = model.queue.shift();
+          model.starts.push({ ...model.active, snapshotText: model.active.text });
+        }
+      };
+      for (const [step, action] of actions.entries()) {
+        const state = controller.state();
+        switch (action.kind) {
+          case 'submit': {
+            assert.equal((await controller.command({ kind: 'submit', text: action.text })).kind, 'accepted');
+            model.queue.push({ id: `item-${next}`, text: action.text });
+            dispatch();
+            break;
+          }
+          case 'complete':
+          case 'fail':
+            if (model.active) {
+              await controller.event({
+                kind: action.kind === 'complete' ? 'completed' : 'failed',
+                executionId: state.active.executionId,
+                terminal: {},
+                failure: 'generated',
+              });
+              previousExecutionId = state.active.executionId;
+              model.active = null;
+              model.paused = action.kind === 'fail' && model.queue.length > 0;
+              dispatch();
+            }
+            break;
+          case 'remove':
+          case 'edit':
+            if (model.queue.length) {
+              const index = action.index % model.queue.length;
+              await controller.command({
+                kind: action.kind === 'remove' ? 'remove_queued' : 'edit_queued',
+                itemId: model.queue[index].id,
+                text: 'edited',
+              });
+              if (action.kind === 'remove') model.queue.splice(index, 1);
+              else model.queue[index].text = 'edited';
+              if (!model.queue.length) model.paused = false;
+            }
+            break;
+          case 'resume':
+            await controller.command({ kind: 'resume_queue' });
+            model.paused = false;
+            dispatch();
+            break;
+          case 'discard':
+            await controller.command({ kind: 'discard_queue' });
+            model.queue = [];
+            model.paused = false;
+            break;
+          case 'stale':
+            await controller.event({
+              kind: 'completed',
+              executionId: previousExecutionId ?? 'never-issued',
+              terminal: {},
+            });
+            break;
+        }
+        const actual = controller.state();
+        assert.deepEqual(
+          actual.queue.map(({ id, text }) => ({ id, text })),
+          model.queue,
+          `queue at step ${step}`,
+        );
+        assert.deepEqual(
+          actual.active ? { id: actual.active.item.id, text: actual.active.item.text } : null,
+          model.active,
+          `active at step ${step}`,
+        );
+        assert.equal(actual.kind, model.active ? 'running' : model.paused ? 'paused' : 'idle', `phase at step ${step}`);
+        assert.deepEqual(starts, model.starts, `dispatch at step ${step}`);
+      }
+    }),
+  },
+];
diff --git a/scripts/generated-verification/run.mjs b/scripts/generated-verification/run.mjs
new file mode 100644
index 00000000..10df6b87
--- /dev/null
+++ b/scripts/generated-verification/run.mjs
@@ -0,0 +1,92 @@
+import { execFileSync } from 'node:child_process';
+import { parseArgs } from 'node:util';
+import { writeFileSync } from 'node:fs';
+import fc from 'fast-check';
+import { historyProperties } from './history.mjs';
+import { queueProperties } from './queue.mjs';
+
+// No provider, credential, model, or network dependency: only production APIs
+// and fast-check. JSON on stdout is the durable replay/evaluation artifact.
+try {
+  const { values } = parseArgs({
+    options: {
+      target: { type: 'string', default: 'all' },
+      property: { type: 'string' },
+      seed: { type: 'string' },
+      path: { type: 'string' },
+      runs: { type: 'string', default: '1000' },
+      output: { type: 'string' },
+      help: { type: 'boolean' },
+    },
+  });
+  if (values.help) {
+    console.log(
+      'pnpm verify:generated [--target all|history|queue] [--property NAME] [--runs N] [--seed INT] [--path SHRINK_PATH] [--output FILE]',
+    );
+  } else {
+    const runs = Number(values.runs);
+    const seed = values.seed === undefined ? undefined : Number(values.seed);
+    if (
+      !Number.isSafeInteger(runs) ||
+      runs < 1 ||
+      (seed !== undefined && (!Number.isInteger(seed) || seed < -2147483648 || seed > 2147483647))
+    )
+      throw new Error('runs must be a positive safe integer; seed must be int32');
+    if (!['all', 'history', 'queue'].includes(values.target)) throw new Error('unknown target');
+    let properties =
+      values.target === 'history'
+        ? historyProperties
+        : values.target === 'queue'
+        ? queueProperties
+        : [...historyProperties, ...queueProperties];
+    if (values.property) properties = properties.filter((p) => p.name === values.property);
+    if (!properties.length) throw new Error('unknown property for target');
+    if (values.path !== undefined && (properties.length !== 1 || seed === undefined))
+      throw new Error('replay path requires --property and --seed');
+    const git = (...args) => execFileSync('git', args, { encoding: 'utf8' }).trim();
+    const revision = git('rev-parse', 'HEAD');
+    const dirty = git('status', '--porcelain').length > 0;
+    const started = performance.now();
+    const results = [];
+    for (const { name, property } of properties) {
+      const start = performance.now();
+      const result = await fc.check(property, {
+        numRuns: runs,
+        ...(seed === undefined ? {} : { seed }),
+        ...(values.path === undefined ? {} : { path: values.path }),
+      });
+      results.push({
+        property: name,
+        failed: result.failed,
+        seed: result.seed,
+        path: result.counterexamplePath,
+        cases: result.numRuns,
+        skips: result.numSkips,
+        shrinks: result.numShrinks,
+        runtimeMs: performance.now() - start,
+        counterexample: result.counterexample,
+        error: result.errorInstance ? String(result.errorInstance.stack ?? result.errorInstance) : null,
+        replay: result.failed
+          ? `pnpm verify:generated --property ${name} --seed ${result.seed} --path '${result.counterexamplePath}' --runs ${runs}`
+          : null,
+      });
+    }
+    const report = {
+      schemaVersion: 1,
+      revision,
+      dirty,
+      node: process.version,
+      requestedRunsPerProperty: runs,
+      maxSequenceLength: 30,
+      runtimeMs: performance.now() - started,
+      results,
+    };
+    const json = JSON.stringify(report, null, 2) + '\n';
+    if (values.output) writeFileSync(values.output, json, { flag: 'wx' });
+    process.stdout.write(json);
+    if (results.some((r) => r.failed)) process.exitCode = 1;
+  }
+} catch (error) {
+  console.error(String(error.stack ?? error));
+  process.exitCode = 2;
+}
