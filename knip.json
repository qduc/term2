{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "entry": [
    "rewrite/src/app/cli.ts",
    "rewrite/src/session/hooks/index.ts",
    "rewrite/src/shared/utils/worker-cwd-preload.cts",
    "scripts/*.ts",
    "scripts/*.mjs",
    "scripts/nested-approval/*.ts",
    "scripts/teammate-memory/*.ts",
    "scripts/test-audit/*.ts",
    "scripts/provider-black-box/*.ts",
    "scripts/provider-black-box/*.mjs",
    "vitest*.config.ts"
  ],
  "project": ["rewrite/src/**/*.{ts,tsx,cts}", "tests/**/*.{ts,tsx}", "scripts/**/*.{ts,tsx,mjs}", "vitest*.config.ts"],
  "ignore": ["scripts/experiments/**", "scripts/provider-black-box/fixtures/**", "eval/**", "website/**", "tools/**"],
  "ignoreDependencies": ["minimal", "@earendil-works/pi-ai"]
}
