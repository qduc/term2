{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "entry": [
    "source/cli.tsx",
    "source/services/hooks/index.ts",
    "source/utils/worker-cwd-preload.cts",
    "source/scripts/**/*.ts",
    "scripts/*.ts",
    "scripts/*.mjs",
    "scripts/nested-approval/*.ts",
    "scripts/teammate-memory/*.ts",
    "scripts/test-audit/*.ts",
    "scripts/provider-black-box/*.ts",
    "scripts/provider-black-box/*.mjs",
    "vitest*.config.ts"
  ],
  "project": ["source/**/*.{ts,tsx,cts}", "scripts/**/*.{ts,tsx,mjs}", "vitest*.config.ts"],
  "ignore": [
    "scripts/experiments/**",
    "scripts/provider-black-box/fixtures/**",
    "source/services/mcp/test-fixtures/**",
    "eval/**",
    "website/**",
    "tools/**"
  ],
  "ignoreDependencies": ["minimal", "@earendil-works/pi-ai"]
}
