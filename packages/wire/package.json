{
  "name": "@qduc/agent-wire",
  "version": "0.1.0",
  "description": "Dependency-free agent event and interaction wire contracts shared by Term2 and ChatForge",
  "license": "MIT",
  "author": "qduc",
  "repository": {
    "type": "git",
    "url": "https://github.com/qduc/term2.git",
    "directory": "packages/wire"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "tsc -p tsconfig.json && vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.1",
    "vitest": "^4.1.9"
  }
}
