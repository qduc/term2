{
  "id": "settings-batch",
  "description": "A saved retired Pair profile falls back to Bare while a headless run retains model, generation, and tool-toggle settings in its provider request and CLI output.",
  "runs": [
    {
      "args": ["--auto-approve", "say hello"]
    }
  ],
  "settings": {
    "agent": {
      "modelSelection": {
        "model": "mock-beta",
        "provider": "mockprov"
      },
      "reasoningEffort": "high",
      "temperature": 0.2,
      "maxOutputTokens": 1234
    },
    "app": {
      "activeProfileId": "builtin:pair"
    },
    "tools": {
      "shell": {
        "enabled": false
      },
      "web": {
        "enabled": false
      },
      "memory": {
        "enabled": false
      },
      "fileWrite": {
        "enabled": false
      },
      "subagents": {
        "enabled": false
      }
    }
  },
  "provider": [{ "text": "Hello there." }]
}
