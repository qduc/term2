# term2 web client configuration.
# Copy to .env.local for local runs.

# Gateway access (consumed by the thin API routes, not the browser).
# TERM2_GATEWAY_SOCKET_PATH=/home/<you>/.local/state/term2-nodejs/gateway/gateway.sock

# The local-owner user id the gateway was started with (--local-owner).
# TERM2_LOCAL_OWNER_USER_ID=local-owner
